#!/usr/bin/env bash
# Export a read-only mirror of local Codex session logs.

set -euo pipefail

readonly SCRIPT_NAME="$(basename "$0")"
readonly EXPORT_FORMAT_VERSION="5"
readonly LANDING_MARKER="<!-- codex-portable-context: derived-mirror -->"

codex_home="${CODEX_HOME:-$HOME/.codex}"
source_dir=""
output_dir=""
session_index=""
redact_mode="false"
include_context="true"
include_tools="true"
include_events="true"
profile_name="full"
hostname_short=""
hostname_fqdn=""

declare -A previous_signature_by_relpath=()
declare -A previous_metadata_by_relpath=()
declare -A previous_markdown_by_relpath=()
declare -A seen_relpath=()

usage() {
  cat <<EOF
Usage: ${SCRIPT_NAME} [--codex-home PATH] [--source-dir PATH] [--out-dir PATH] [--redact] [--no-context] [--no-tools] [--no-events] [--conversation-only]

Export a read-only mirror of local Codex sessions into a derived output tree.
EOF
}

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'Missing required command: %s\n' "$1" >&2
    exit 1
  fi
}

extract_session_id() {
  local file_path="$1"
  local session_id

  session_id="$(
    jq -r 'select(.type == "session_meta") | .payload.id // empty' "${file_path}" | head -n 1
  )"

  if [[ -n "${session_id}" ]]; then
    printf '%s\n' "${session_id}"
  else
    basename "${file_path%.jsonl}"
  fi
}

relative_to_source() {
  local file_path="$1"

  if [[ "${file_path}" == "${source_dir}/"* ]]; then
    printf '%s\n' "${file_path#"${source_dir}/"}"
  else
    printf '%s\n' "${file_path}"
  fi
}

lookup_session_index_field() {
  local session_id="$1"
  local field_name="$2"

  if [[ ! -f "${session_index}" ]]; then
    return 0
  fi

  jq -r \
    --arg id "${session_id}" \
    --arg field "${field_name}" \
    'select(.id == $id) | .[$field] // empty' \
    "${session_index}" | tail -n 1
}

derive_session_title() {
  local file_path="$1"
  local thread_name="$2"
  local session_id="$3"
  local title=""

  if [[ -n "${thread_name}" ]]; then
    printf '%s\n' "${thread_name}"
    return 0
  fi

  title="$(
    jq -r \
      'select(.type == "event_msg" and .payload.type == "user_message") | (.payload.message // "")' \
      "${file_path}" \
      | sed -n '/[^[:space:]]/{s/[[:space:]]\+/ /g;p;q;}'
  )"

  if [[ -z "${title}" ]]; then
    printf 'Session %s\n' "${session_id}"
    return 0
  fi

  if [[ "${#title}" -gt 96 ]]; then
    title="${title:0:93}..."
  fi

  printf '%s\n' "${title}"
}

file_stat_fingerprint() {
  local file_path="$1"

  stat -c '%Y:%s' -- "${file_path}"
}

build_input_signature() {
  local file_path="$1"
  local session_id="$2"
  local thread_name="$3"
  local updated_at="$4"

  jq -cn \
    --arg export_format_version "${EXPORT_FORMAT_VERSION}" \
    --arg source_fingerprint "$(file_stat_fingerprint "${file_path}")" \
    --arg session_id "${session_id}" \
    --arg thread_name "${thread_name}" \
    --arg updated_at "${updated_at}" \
    --arg redact_mode "${redact_mode}" \
    --arg profile_name "${profile_name}" \
    --arg include_context "${include_context}" \
    --arg include_tools "${include_tools}" \
    --arg include_events "${include_events}" \
    --arg user_name "${USER:-}" \
    --arg home_dir "${HOME:-}" \
    --arg hostname_short "${hostname_short}" \
    --arg hostname_fqdn "${hostname_fqdn}" \
    '{
      export_format_version: $export_format_version,
      source_fingerprint: $source_fingerprint,
      session_id: $session_id,
      thread_name: $thread_name,
      updated_at: $updated_at,
      redact_mode: $redact_mode,
      profile_name: $profile_name,
      markdown_includes: {
        context: $include_context,
        tools: $include_tools,
        events: $include_events
      },
      redaction_context: {
        user_name: $user_name,
        home_dir: $home_dir,
        hostname_short: $hostname_short,
        hostname_fqdn: $hostname_fqdn
      }
    }' \
    | sha256sum \
    | awk '{print $1}'
}

load_previous_state() {
  local state_path="$1"

  if [[ ! -s "${state_path}" ]]; then
    return 0
  fi

  while IFS=$'\t' read -r source_relpath input_signature session_id metadata_relpath markdown_relpath; do
    previous_signature_by_relpath["${source_relpath}"]="${input_signature}"
    previous_metadata_by_relpath["${source_relpath}"]="${metadata_relpath}"
    previous_markdown_by_relpath["${source_relpath}"]="${markdown_relpath}"
  done < <(
    jq -r \
      '[.source_relpath, .input_signature, .session_id, .metadata_relpath, .markdown_relpath] | @tsv' \
      "${state_path}"
  )
}

append_state_record() {
  local state_path="$1"
  local source_relpath="$2"
  local input_signature="$3"
  local session_id="$4"
  local metadata_relpath="$5"
  local markdown_relpath="$6"

  jq -cn \
    --arg source_relpath "${source_relpath}" \
    --arg input_signature "${input_signature}" \
    --arg session_id "${session_id}" \
    --arg metadata_relpath "${metadata_relpath}" \
    --arg markdown_relpath "${markdown_relpath}" \
    '{
      source_relpath: $source_relpath,
      input_signature: $input_signature,
      session_id: $session_id,
      metadata_relpath: $metadata_relpath,
      markdown_relpath: $markdown_relpath
    }' >> "${state_path}"
}

remove_if_present() {
  local file_path="$1"

  if [[ -n "${file_path}" && -f "${file_path}" ]]; then
    rm -f "${file_path}"
    return 0
  fi

  return 1
}

redact_stream() {
  REDACT_USER="${USER:-}" \
  REDACT_HOME="${HOME:-}" \
  REDACT_HOST_SHORT="${hostname_short}" \
  REDACT_HOST_FQDN="${hostname_fqdn}" \
  perl -0pe '
    s{\Q$ENV{REDACT_HOME}\E}{<redacted-home>}g if length($ENV{REDACT_HOME} // q());
    s{/home/[^/\s]+}{<redacted-home>}g;
    s{/Users/[^/\s]+}{<redacted-home>}g;
    s{\b\Q$ENV{REDACT_USER}\E\b}{<redacted-user>}g if length($ENV{REDACT_USER} // q());
    s{\b\Q$ENV{REDACT_HOST_FQDN}\E\b}{<redacted-host>}g if length($ENV{REDACT_HOST_FQDN} // q());
    s{@\Q$ENV{REDACT_HOST_SHORT}\E\b}{@<redacted-host>}g if length($ENV{REDACT_HOST_SHORT} // q());
    s{\b(hostname|host)\s*[:=]\s*\Q$ENV{REDACT_HOST_SHORT}\E\b}{$1: <redacted-host>}gi if length($ENV{REDACT_HOST_SHORT} // q());
    s{\bsk-[A-Za-z0-9_-]{16,}\b}{<redacted-secret>}g;
    s{\bgh[pousr]_[A-Za-z0-9]{20,}\b}{<redacted-secret>}g;
    s{\bgithub_pat_[A-Za-z0-9_]{20,}\b}{<redacted-secret>}g;
    s{\bAKIA[0-9A-Z]{16}\b}{<redacted-secret>}g;
    s{\bBearer\s+[A-Za-z0-9._-]{16,}\b}{Bearer <redacted-secret>}g;
    s{\bxox[baprs]-[A-Za-z0-9-]{10,}\b}{<redacted-secret>}g;
  '
}

write_with_optional_redaction() {
  local temp_path="$1"
  local target_path="$2"

  if [[ "${redact_mode}" == "true" ]]; then
    redact_stream < "${temp_path}" > "${target_path}"
    rm -f "${temp_path}"
  else
    mv "${temp_path}" "${target_path}"
  fi
}

write_landing() {
  local index_path="$1"
  local landing_path="$2"
  local exported_at="$3"
  local landing_redacted="$4"
  local temp_path

  temp_path="$(mktemp)"

  if [[ -f "${landing_path}" ]] && ! grep -Fq "${LANDING_MARKER}" "${landing_path}"; then
    printf 'Refusing to overwrite existing non-mirror README: %s\n' "${landing_path}" >&2
    printf 'Choose a dedicated output directory for the derived mirror.\n' >&2
    rm -f "${temp_path}"
    exit 1
  fi

  jq -rs \
    --arg exported_at "${exported_at}" \
    --arg landing_marker "${LANDING_MARKER}" \
    --argjson landing_redacted "$( [[ "${landing_redacted}" == "true" ]] && printf 'true' || printf 'false' )" \
    '
      def pretty_ts($value):
        if ($value // "") == "" then
          "unknown"
        else
          ($value | sub("\\.[0-9]+Z$"; "Z") | gsub("T"; " "))
        end;

      def session_sort_key:
        (.updated_at // .session_timestamp // .exported_at // "");

      def yes_no($value):
        if $value then "yes" else "no" end;

      def render_session($entry):
        [
          "### " + ($entry.title // ("Session " + $entry.session_id)),
          "",
          "- Session ID: `" + $entry.session_id + "`",
          "- Updated: `" + pretty_ts(($entry | session_sort_key)) + "`",
          "- Transcript: [" + ($entry.markdown_relpath // ("sessions/" + $entry.session_id + ".md")) + "](" + ($entry.markdown_relpath // ("sessions/" + $entry.session_id + ".md")) + ")",
          "- Metadata: [" + ($entry.metadata_relpath // ("metadata/" + $entry.session_id + ".json")) + "](" + ($entry.metadata_relpath // ("metadata/" + $entry.session_id + ".json")) + ")"
        ]
        + (
            if (($entry.summary.one_line // "") == "") then
              []
            else
              ["- Summary: " + $entry.summary.one_line]
            end
          )
        + [""];

      (sort_by(session_sort_key, .session_id) | reverse) as $entries
      | ($entries | length) as $session_count
      | (($entries[0] | session_sort_key) // "") as $latest_timestamp
      | (
          if $session_count == 0 then
            $landing_redacted
          else
            ($entries | any(.redacted == true))
          end
        ) as $is_redacted
      | (
          [
            $landing_marker,
            "# Codex Portable Context Mirror",
            "",
            "This directory is a derived read-only mirror generated from local Codex session exports.",
            "It is intended for browsing and transport. It is not a writable Codex state directory.",
            "",
            "## Mirror Summary",
            "",
          "- Exported at: `" + pretty_ts($exported_at) + "`",
          "- Sessions: `" + ($session_count | tostring) + "`",
          "- Latest session update: `" + pretty_ts($latest_timestamp) + "`",
            "- Redacted export: `" + yes_no($is_redacted) + "`",
            "- Session index: [sessions-index.jsonl](sessions-index.jsonl)",
            ""
          ]
          + if $session_count == 0 then
              [
                "## Sessions",
                "",
                "_No sessions are currently exported in this mirror._",
                ""
              ]
            else
              (
                ["## Sessions", ""]
                + ($entries | map(render_session(.)) | add)
              )
            end
        )
      | join("\n")
    ' "${index_path}" > "${temp_path}"

  write_with_optional_redaction "${temp_path}" "${landing_path}"
}

write_metadata() {
  local file_path="$1"
  local session_id="$2"
  local metadata_path="$3"
  local metadata_relpath="$4"
  local markdown_relpath="$5"
  local source_relpath="$6"
  local thread_name="$7"
  local updated_at="$8"
  local exported_at="$9"
  local title="${10}"
  local export_profile="${11}"
  local temp_path

  temp_path="$(mktemp)"

  jq -s \
    --arg session_id "${session_id}" \
    --arg title "${title}" \
    --arg source_file "${file_path}" \
    --arg metadata_relpath "${metadata_relpath}" \
    --arg markdown_relpath "${markdown_relpath}" \
    --arg source_relpath "${source_relpath}" \
    --arg thread_name "${thread_name}" \
    --arg updated_at "${updated_at}" \
    --arg exported_at "${exported_at}" \
    --arg export_profile "${export_profile}" \
    --argjson redacted "$( [[ "${redact_mode}" == "true" ]] && printf 'true' || printf 'false' )" \
    --argjson include_context "$( [[ "${include_context}" == "true" ]] && printf 'true' || printf 'false' )" \
    --argjson include_tools "$( [[ "${include_tools}" == "true" ]] && printf 'true' || printf 'false' )" \
    --argjson include_events "$( [[ "${include_events}" == "true" ]] && printf 'true' || printf 'false' )" \
    '
      def clean_excerpt($value; $max_length):
        ($value // "")
        | gsub("[[:space:]]+"; " ")
        | sub("^ "; "")
        | sub(" $"; "")
        | if . == "" then
            null
          elif (length > $max_length) then
            .[0:($max_length - 3)] + "..."
          else
            .
          end;

      def path_tail($value):
        if ($value // "") == "" then
          null
        else
          ($value | split("/") | last)
        end;

      (map(select(.type == "session_meta")) | first | .payload // {}) as $meta
      | (
          map(
            select(.type == "response_item" and .payload.type == "message" and .payload.role != "assistant")
          )
        ) as $context_entries
      | (
          map(
            select(.type == "event_msg" and .payload.type == "user_message")
            | (.payload.message // "")
            | clean_excerpt(.; 140)
          )
          | map(select(. != null))
        ) as $user_messages
      | (
          map(
            select(.type == "event_msg" and .payload.type == "agent_message")
            | (.payload.message // "")
            | clean_excerpt(.; 140)
          )
          | map(select(. != null))
        ) as $assistant_messages
      | (
          map(select(.type == "response_item" and .payload.type == "function_call"))
        ) as $tool_calls
      | (
          map(select(.type == "response_item" and .payload.type == "function_call_output"))
        ) as $tool_outputs
      | (
          map(
            select(
              .type == "event_msg"
              and (
                .payload.type == "task_started"
                or .payload.type == "task_complete"
                or .payload.type == "thread_rolled_back"
                or .payload.type == "turn_aborted"
              )
            )
          )
        ) as $notable_events
      | ($context_entries | length) as $context_entry_count
      | ($user_messages | length) as $user_message_count
      | ($assistant_messages | length) as $assistant_message_count
      | ($tool_calls | length) as $tool_call_count
      | ($tool_outputs | length) as $tool_output_count
      | ($notable_events | length) as $notable_event_count
      | (
          (
            ($user_message_count | tostring) + " user, "
            + ($assistant_message_count | tostring) + " assistant, "
            + ($tool_call_count | tostring) + " tool calls, "
            + ($tool_output_count | tostring) + " tool outputs"
            + (
                if $notable_event_count > 0 then
                  ", " + ($notable_event_count | tostring) + " notable events"
                else
                  ""
                end
              )
          )
        ) as $activity_summary
      | (
          [
            if (($meta.cwd // "") != "") then
              "cwd: " + (path_tail($meta.cwd) // $meta.cwd)
            else
              empty
            end,
            if (($meta.source // "") != "") then
              "source: " + $meta.source
            else
              empty
            end,
            if (($meta.originator // "") != "") then
              "originator: " + $meta.originator
            else
              empty
            end
          ]
          | if length == 0 then null else join(", ") end
        ) as $environment_summary
      | {
          session_id: $session_id,
          title: $title,
          export_profile: $export_profile,
          thread_name: (if $thread_name == "" then null else $thread_name end),
          exported_at: $exported_at,
          updated_at: (if $updated_at == "" then null else $updated_at end),
          source_file: $source_file,
          source_relpath: $source_relpath,
          metadata_relpath: $metadata_relpath,
          markdown_relpath: $markdown_relpath,
          session_timestamp: ($meta.timestamp // null),
          cwd: ($meta.cwd // null),
          originator: ($meta.originator // null),
          source: ($meta.source // null),
          model_provider: ($meta.model_provider // null),
          cli_version: ($meta.cli_version // null),
          redacted: $redacted,
          markdown_includes: {
            context: $include_context,
            tools: $include_tools,
            events: $include_events
          },
          summary: {
            first_user_message: ($user_messages | first // null),
            last_user_message: ($user_messages | last // null),
            last_assistant_message: ($assistant_messages | last // null),
            activity: $activity_summary,
            environment: $environment_summary,
            one_line: (
              [$activity_summary, $environment_summary]
              | map(select(. != null and . != ""))
              | if length == 0 then null else join(" | ") end
            )
          },
          event_count: length,
          context_entry_count: $context_entry_count,
          user_message_count: $user_message_count,
          assistant_message_count: $assistant_message_count,
          tool_call_count: $tool_call_count,
          tool_output_count: $tool_output_count,
          notable_event_count: $notable_event_count,
          markdown_filter_rules: [
            "Routine token_count events are omitted from Markdown.",
            "turn_context records are omitted from Markdown.",
            "Assistant response_item message wrappers are omitted when agent_message events already carry the readable text.",
            "Notable lifecycle events are grouped in a separate Markdown section.",
            "Raw source session files remain the authoritative input."
          ]
        }
    ' "${file_path}" > "${temp_path}"

  write_with_optional_redaction "${temp_path}" "${metadata_path}"
}

write_markdown() {
  local file_path="$1"
  local session_id="$2"
  local markdown_path="$3"
  local title="$4"
  local thread_name="$5"
  local updated_at="$6"
  local export_profile="$7"
  local temp_path

  temp_path="$(mktemp)"

  jq -rs \
    --arg session_id "${session_id}" \
    --arg title "${title}" \
    --arg thread_name "${thread_name}" \
    --arg updated_at "${updated_at}" \
    --arg export_profile "${export_profile}" \
    --argjson include_context "$( [[ "${include_context}" == "true" ]] && printf 'true' || printf 'false' )" \
    --argjson include_tools "$( [[ "${include_tools}" == "true" ]] && printf 'true' || printf 'false' )" \
    --argjson include_events "$( [[ "${include_events}" == "true" ]] && printf 'true' || printf 'false' )" \
    '
      def pretty_ts($value):
        if ($value // "") == "" then
          "unknown"
        else
          ($value | sub("\\.[0-9]+Z$"; "Z") | gsub("T"; " "))
        end;

      def context_body($content):
        ($content // [])
        | map(
            select((.type == "input_text") or (.type == "output_text"))
            | .text
          )
        | join("\n\n");

      def render_text_block($heading; $timestamp; $body):
        "### " + $heading + "\n\n"
        + "Timestamp: `" + pretty_ts($timestamp) + "`\n\n"
        + $body;

      def render_tool_block($heading; $timestamp; $language; $body):
        "### " + $heading + "\n\n"
        + "Timestamp: `" + pretty_ts($timestamp) + "`\n\n"
        + "~~~" + $language + "\n"
        + (if $body == "" then "_empty_" else $body end)
        + "\n~~~";

      (reduce .[] as $item (
        {};
        if $item.type == "response_item" and $item.payload.type == "function_call" then
          . + {($item.payload.call_id): ($item.payload.name // "unknown")}
        else
          .
        end
      )) as $call_names

      | (map(select(.type == "session_meta")) | first | .payload // {}) as $meta

      | (
          [
            .[]
            | select(
                .type == "response_item"
                and .payload.type == "message"
                and .payload.role != "assistant"
              )
            | {
                role: (.payload.role // "context"),
                phase: (.payload.phase // null),
                timestamp: (.timestamp // null),
                body: context_body(.payload.content)
              }
            | select(.body != "")
          ]
        ) as $context_entries

      | (
          [
            .[]
            | if .type == "event_msg" and .payload.type == "user_message" then
                {
                  kind: "User",
                  label: null,
                  timestamp: .timestamp,
                  body: (.payload.message // "")
                }
              elif .type == "event_msg" and .payload.type == "agent_message" then
                {
                  kind: "Assistant",
                  label: (.payload.phase // null),
                  timestamp: .timestamp,
                  body: (.payload.message // "")
                }
              elif .type == "response_item" and .payload.type == "function_call" then
                if $include_tools then
                  {
                    kind: "Tool Call",
                    label: (.payload.name // "unknown"),
                    timestamp: (.timestamp // null),
                    body: (
                      (.payload.arguments | fromjson? // .payload.arguments)
                      | if type == "string" then . else tojson end
                    )
                  }
                else
                  empty
                end
              elif .type == "response_item" and .payload.type == "function_call_output" then
                if $include_tools then
                  {
                    kind: "Tool Output",
                    label: ($call_names[.payload.call_id] // .payload.call_id),
                    timestamp: (.timestamp // null),
                    body: (.payload.output // "")
                  }
                else
                  empty
                end
              else
                empty
              end
            | select(.body != "")
          ]
        ) as $conversation_entries

      | (
          [
            .[]
            | select(
                .type == "event_msg"
                and (
                  .payload.type == "task_started"
                  or .payload.type == "task_complete"
                  or .payload.type == "thread_rolled_back"
                  or .payload.type == "turn_aborted"
                )
              )
            | {
                type: .payload.type,
                timestamp: .timestamp,
                body: (
                  if (.payload.last_agent_message // "") != "" then
                    .payload.last_agent_message
                  else
                    ((.payload | del(.type)) | tostring)
                  end
                )
              }
          ]
        ) as $event_entries

      | ($context_entries
          | to_entries
          | map(
              render_text_block(
                (
                  "Context "
                  + ((.key + 1) | tostring)
                  + " ("
                  + .value.role
                  + (
                      if (.value.phase // "") == "" then
                        ""
                      else
                        ", phase: " + .value.phase
                      end
                    )
                  + ")"
                );
                .value.timestamp;
                .value.body
              )
            )
        ) as $context_blocks

      | ($conversation_entries
          | to_entries
          | map(
              if .value.kind == "Tool Call" then
                render_tool_block(
                  (((.key + 1) | tostring) + ". Tool Call: " + .value.label);
                  .value.timestamp;
                  "json";
                  .value.body
                )
              elif .value.kind == "Tool Output" then
                render_tool_block(
                  (((.key + 1) | tostring) + ". Tool Output: " + .value.label);
                  .value.timestamp;
                  "text";
                  .value.body
                )
              else
                render_text_block(
                  (
                    ((.key + 1) | tostring)
                    + ". "
                    + .value.kind
                    + (
                        if (.value.label // "") == "" then
                          ""
                        else
                          " (" + .value.label + ")"
                        end
                      )
                  );
                  .value.timestamp;
                  .value.body
                )
              end
            )
        ) as $conversation_blocks

      | ($event_entries
          | to_entries
          | map(
              render_text_block(
                (
                  "Event "
                  + ((.key + 1) | tostring)
                  + ": "
                  + .value.type
                );
                .value.timestamp;
                .value.body
              )
            )
        ) as $event_blocks

      | (
          [
            "# " + $title,
            "",
            "## Metadata",
            "",
            "- Session ID: `" + $session_id + "`",
            "- Thread Name: " + (if $thread_name == "" then "_unknown_" else "`" + $thread_name + "`" end),
            "- Session Timestamp: `" + pretty_ts($meta.timestamp) + "`",
            "- Updated At: `" + pretty_ts($updated_at) + "`",
            "- CWD: " + (if ($meta.cwd // "") == "" then "_unknown_" else "`" + $meta.cwd + "`" end),
            "",
            "## Export Notes",
            "",
            "- Export profile: `" + $export_profile + "`",
            "- This Markdown omits routine `token_count` and `turn_context` records to reduce noise.",
            "- Raw source session files remain untouched and are the authoritative input."
          ]
          + (if $include_context then [] else ["- Session context omitted by CLI flag."] end)
          + (if $include_tools then [] else ["- Tool calls and tool outputs omitted by CLI flag."] end)
          + (if $include_events then [] else ["- Notable lifecycle events omitted by CLI flag."] end)
          + [""]
          + (
              if $include_context and (($context_blocks | length) > 0) then
                ["## Session Context", ""] + $context_blocks + [""]
              else
                []
              end
            )
          + (
              if ($conversation_blocks | length) == 0 then
                ["## Conversation", "", "_No conversation entries were found in this session export._", ""]
              else
                ["## Conversation", ""] + $conversation_blocks + [""]
              end
            )
          + (
              if $include_events and (($event_blocks | length) > 0) then
                ["## Notable Events", ""] + $event_blocks + [""]
              else
                []
              end
            )
        )
      | join("\n")
    ' "${file_path}" > "${temp_path}"

  write_with_optional_redaction "${temp_path}" "${markdown_path}"
}

export_session() {
  local file_path="$1"
  local source_relpath="$2"
  local session_id="$3"
  local thread_name="$4"
  local updated_at="$5"
  local metadata_relpath="$6"
  local markdown_relpath="$7"
  local metadata_path="$8"
  local markdown_path="$9"
  local index_path="${10}"
  local exported_at="${11}"
  local title
  local export_profile

  title="$(derive_session_title "${file_path}" "${thread_name}" "${session_id}")"
  export_profile="${profile_name}"

  write_metadata \
    "${file_path}" \
    "${session_id}" \
    "${metadata_path}" \
    "${metadata_relpath}" \
    "${markdown_relpath}" \
    "${source_relpath}" \
    "${thread_name}" \
    "${updated_at}" \
    "${exported_at}" \
    "${title}" \
    "${export_profile}"

  write_markdown \
    "${file_path}" \
    "${session_id}" \
    "${markdown_path}" \
    "${title}" \
    "${thread_name}" \
    "${updated_at}" \
    "${export_profile}"

  jq -c . "${metadata_path}" >> "${index_path}"
}

while (($# > 0)); do
  case "$1" in
    --codex-home)
      codex_home="${2:?Missing value for --codex-home}"
      shift 2
      ;;
    --source-dir)
      source_dir="${2:?Missing value for --source-dir}"
      shift 2
      ;;
    --out-dir|--output-dir)
      output_dir="${2:?Missing value for --out-dir}"
      shift 2
      ;;
    --redact)
      redact_mode="true"
      shift
      ;;
    --no-context)
      include_context="false"
      shift
      ;;
    --no-tools)
      include_tools="false"
      shift
      ;;
    --no-events)
      include_events="false"
      shift
      ;;
    --conversation-only)
      include_context="false"
      include_tools="false"
      include_events="false"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'Unknown argument: %s\n' "$1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

require_cmd jq
require_cmd perl
require_cmd sha256sum
require_cmd stat

if [[ -z "${source_dir}" ]]; then
  source_dir="${codex_home}/sessions"
fi

if [[ -z "${output_dir}" ]]; then
  if [[ "${redact_mode}" == "true" ]]; then
    output_dir="${PWD}/out-redacted"
  else
    output_dir="${PWD}/out"
  fi
fi

profile_name="full"
if [[ "${include_context}" == "false" || "${include_tools}" == "false" || "${include_events}" == "false" ]]; then
  profile_name="custom"
fi
if [[ "${include_context}" == "false" && "${include_tools}" == "false" && "${include_events}" == "false" ]]; then
  profile_name="conversation-only"
fi

if [[ "${output_dir}" == "/" ]]; then
  printf 'Refusing to use / as output directory.\n' >&2
  exit 1
fi

session_index="${codex_home}/session_index.jsonl"

if [[ ! -d "${source_dir}" ]]; then
  printf 'Source directory not found: %s\n' "${source_dir}" >&2
  exit 1
fi

hostname_short="$(hostname 2>/dev/null || true)"
hostname_fqdn="$(hostname -f 2>/dev/null || true)"
if [[ "${hostname_fqdn}" != *.* ]]; then
  hostname_fqdn=""
fi

readonly METADATA_DIR="${output_dir}/metadata"
readonly SESSIONS_DIR="${output_dir}/sessions"
readonly INDEX_PATH="${output_dir}/sessions-index.jsonl"
readonly LANDING_PATH="${output_dir}/README.md"
readonly STATE_PATH="${output_dir}/.codex-session-mirror-state.jsonl"
readonly EXPORTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

mkdir -p "${METADATA_DIR}" "${SESSIONS_DIR}"
: > "${INDEX_PATH}"

load_previous_state "${STATE_PATH}"

session_count=0
rendered_count=0
reused_count=0
removed_count=0
state_temp_path="$(mktemp)"
while IFS= read -r file_path; do
  source_relpath="$(relative_to_source "${file_path}")"
  session_id="$(extract_session_id "${file_path}")"
  thread_name="$(lookup_session_index_field "${session_id}" "thread_name")"
  updated_at="$(lookup_session_index_field "${session_id}" "updated_at")"
  input_signature="$(build_input_signature "${file_path}" "${session_id}" "${thread_name}" "${updated_at}")"
  metadata_relpath="metadata/${session_id}.json"
  markdown_relpath="sessions/${session_id}.md"
  metadata_path="${output_dir}/${metadata_relpath}"
  markdown_path="${output_dir}/${markdown_relpath}"

  seen_relpath["${source_relpath}"]=1

  if [[ -n "${previous_metadata_by_relpath[${source_relpath}]:-}" && "${previous_metadata_by_relpath[${source_relpath}]}" != "${metadata_relpath}" ]]; then
    if remove_if_present "${output_dir}/${previous_metadata_by_relpath[${source_relpath}]}"; then
      removed_count=$((removed_count + 1))
    fi
  fi
  if [[ -n "${previous_markdown_by_relpath[${source_relpath}]:-}" && "${previous_markdown_by_relpath[${source_relpath}]}" != "${markdown_relpath}" ]]; then
    if remove_if_present "${output_dir}/${previous_markdown_by_relpath[${source_relpath}]}"; then
      removed_count=$((removed_count + 1))
    fi
  fi

  if [[ "${previous_signature_by_relpath[${source_relpath}]:-}" == "${input_signature}" \
    && -f "${metadata_path}" \
    && -f "${markdown_path}" ]]; then
    jq -c . "${metadata_path}" >> "${INDEX_PATH}"
    reused_count=$((reused_count + 1))
  else
    export_session \
      "${file_path}" \
      "${source_relpath}" \
      "${session_id}" \
      "${thread_name}" \
      "${updated_at}" \
      "${metadata_relpath}" \
      "${markdown_relpath}" \
      "${metadata_path}" \
      "${markdown_path}" \
      "${INDEX_PATH}" \
      "${EXPORTED_AT}"
    rendered_count=$((rendered_count + 1))
  fi

  append_state_record \
    "${state_temp_path}" \
    "${source_relpath}" \
    "${input_signature}" \
    "${session_id}" \
    "${metadata_relpath}" \
    "${markdown_relpath}"

  session_count=$((session_count + 1))
done < <(find "${source_dir}" -type f -name 'rollout-*.jsonl' | sort)

for source_relpath in "${!previous_signature_by_relpath[@]}"; do
  if [[ -n "${seen_relpath[${source_relpath}]:-}" ]]; then
    continue
  fi

  if remove_if_present "${output_dir}/${previous_metadata_by_relpath[${source_relpath}]}" ; then
    removed_count=$((removed_count + 1))
  fi
  if remove_if_present "${output_dir}/${previous_markdown_by_relpath[${source_relpath}]}" ; then
    removed_count=$((removed_count + 1))
  fi
done

mv "${state_temp_path}" "${STATE_PATH}"
write_landing "${INDEX_PATH}" "${LANDING_PATH}" "${EXPORTED_AT}" "${redact_mode}"

if [[ "${session_count}" -eq 0 ]]; then
  printf 'No session files found under %s (removed %d stale derived file(s))\n' \
    "${source_dir}" "${removed_count}"
  exit 0
fi

if [[ "${redact_mode}" == "true" ]]; then
  printf 'Mirrored %d redacted session(s) to %s (rendered %d, reused %d, removed %d)\n' \
    "${session_count}" "${output_dir}" "${rendered_count}" "${reused_count}" "${removed_count}"
else
  printf 'Mirrored %d session(s) to %s (rendered %d, reused %d, removed %d)\n' \
    "${session_count}" "${output_dir}" "${rendered_count}" "${reused_count}" "${removed_count}"
fi
