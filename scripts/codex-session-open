#!/usr/bin/env bash
# Open or print a derived session export from the local mirror.

set -euo pipefail

readonly SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

source "${SCRIPT_DIR}/libcodex-session.sh"

out_dir=""
target_kind="markdown"
print_only="false"
selector=""
open_landing="false"
open_latest="false"

usage() {
  cat <<EOF
Usage: ${SCRIPT_NAME} [--out-dir PATH] [--metadata] [--print] [--landing | --latest | <session-id-or-prefix>]

Open or print a derived Markdown or metadata file from the exported mirror.
EOF
}

while (($# > 0)); do
  case "$1" in
    --out-dir)
      out_dir="${2:?Missing value for --out-dir}"
      shift 2
      ;;
    --metadata)
      target_kind="metadata"
      shift
      ;;
    --print)
      print_only="true"
      shift
      ;;
    --landing)
      open_landing="true"
      shift
      ;;
    --latest)
      open_latest="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      if [[ -n "${selector}" ]]; then
        printf 'Only one session selector is allowed.\n' >&2
        exit 1
      fi
      selector="$1"
      shift
      ;;
  esac
done

if [[ "${open_landing}" == "true" && "${open_latest}" == "true" ]]; then
  printf 'Use only one of --landing or --latest.\n' >&2
  exit 1
fi

if [[ "${open_landing}" == "true" && "${target_kind}" == "metadata" ]]; then
  printf -- '--metadata cannot be combined with --landing.\n' >&2
  exit 1
fi

if [[ "${open_landing}" == "false" && "${open_latest}" == "false" && -z "${selector}" ]]; then
  usage >&2
  exit 1
fi

if [[ ("${open_landing}" == "true" || "${open_latest}" == "true") && -n "${selector}" ]]; then
  printf 'Do not pass a session selector with --landing or --latest.\n' >&2
  exit 1
fi

if [[ -z "${out_dir}" ]]; then
  out_dir="$(mirror_default_out_dir)"
fi

if [[ "${open_landing}" == "true" ]]; then
  target_path="$(mirror_require_landing "${out_dir}")"
else
  mirror_require_cmd jq
  index_path="$(mirror_require_index "${out_dir}")"
  if [[ "${open_latest}" == "true" ]]; then
    entry_json="$(mirror_latest_entry "${index_path}")"
    if [[ "${entry_json}" == "null" || -z "${entry_json}" ]]; then
      printf 'No exported sessions are available in %s\n' "${out_dir}" >&2
      exit 1
    fi
  else
    entry_json="$(mirror_resolve_unique_entry "${index_path}" "${selector}")"
  fi
  target_path="$(mirror_entry_path "${out_dir}" "${target_kind}" "${entry_json}")"
fi

if [[ ! -f "${target_path}" ]]; then
  printf 'Derived file not found: %s\n' "${target_path}" >&2
  printf 'Re-run scripts/codex-session-mirror to refresh the mirror.\n' >&2
  exit 1
fi

if [[ "${print_only}" == "true" ]]; then
  printf '%s\n' "${target_path}"
  exit 0
fi

mirror_open_file "${target_path}"
